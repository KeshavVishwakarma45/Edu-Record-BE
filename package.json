{
  "name": "edu-record-be",
  "version": "0.1.0",
  "private": true,
  "description": "EduRecords API: Express + MongoDB backend for the Sant Singaji Education Society portal",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "db:local": "node scripts/localDb.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md}": "prettier --check"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/setupEnv.js"
    ],
    "testTimeout": 60000,
    "transform": {}
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "joi": "18.3.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "morgan": "1.12.1",
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "16.4.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  }
}
